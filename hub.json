{
  "$schema": "https://raw.githubusercontent.com/CodexX64/hub-registry/main/schema/hub-extension.v1.json",
  "manifestVersion": 1,
  "id": "vigie",
  "name": "VIGIE",
  "version": "1.2.8",
  "description": "Audit, veille et bouclier du réseau : règles Codex64, IPS de la passerelle UniFi croisé aux listes de menaces, attaquants bloqués à la frontière, IA au choix.",
  "icon": "shield",
  "repository": "https://github.com/CodexX64/vigie",
  "license": "MIT",
  "minHubVersion": "0.9.0",
  "install": {
    "type": "compose",
    "compose": "deploy/compose.hub.yml",
    "remote": {
      "supported": true,
      "label": "Adresse de VIGIE",
      "placeholder": "http://192.0.2.10:8170",
      "defaultPort": 8170,
      "setupHelp": "Pour une VIGIE déjà en service ailleurs : poser VIGIE_HUB_TOKEN dans son environnement, redémarrer, puis coller ce jeton ici."
    },
    "healthcheck": {
      "type": "http",
      "path": "/api/health",
      "expect": 200,
      "timeout": "5s"
    },
    "arch": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "ramMb": 384,
      "cpu": 1.0,
      "diskMb": 512
    },
    "ports": [
      {
        "name": "http",
        "container": 8170,
        "protocol": "http",
        "expose": "proxy"
      }
    ],
    "volumes": [
      {
        "name": "data",
        "path": "/data"
      }
    ]
  },
  "config": [
    {
      "key": "IMAGE_TAG",
      "label": "Version de l'image",
      "type": "string",
      "default": "1.2.8",
      "help": "Étiquette de l'image vigie.",
      "advanced": true
    },
    {
      "key": "VIGIE_IA_MODE",
      "label": "IA de relecture",
      "type": "select",
      "default": "aucune",
      "required": true,
      "options": [
        {
          "value": "aucune",
          "label": "Aucune — le moteur de règles seul"
        },
        {
          "value": "locale",
          "label": "Locale — l'Ollama du Hub, rien ne sort du réseau"
        },
        {
          "value": "cloud",
          "label": "En nuage — Claude, GPT ou Kimi avec ta clé"
        },
        {
          "value": "les-deux",
          "label": "Les deux — la locale relit, le nuage tranche et rédige"
        },
        {
          "value": "secours",
          "label": "Secours — la locale, le nuage si elle échoue"
        }
      ],
      "help": "L'IA relit chaque audit (confirme ou écarte les constats, rédige la synthèse) ; elle ne change ni les gravités ni le score. Se change ensuite dans VIGIE → Réglages."
    },
    {
      "key": "VIGIE_IA_MODELE_LOCAL",
      "label": "Modèle local",
      "type": "select",
      "optionsFrom": {
        "from": {
          "capability": "llm.chat"
        },
        "method": "GET",
        "path": "/api/tags",
        "select": "$.models",
        "map": {
          "value": "$.name",
          "label": "$.name"
        },
        "exclude": [
          "embed"
        ]
      },
      "help": "Le modèle de l'Ollama du Hub qui relit les audits. Vide : celui d'Ollama par défaut. L'assistant du Hub le règle aussi (« connecte VIGIE à l'IA locale qwen3:8b »).",
      "showIf": {
        "VIGIE_IA_MODE": [
          "locale",
          "les-deux",
          "secours"
        ]
      }
    },
    {
      "key": "VIGIE_IA_FOURNISSEUR",
      "label": "Fournisseur en nuage",
      "type": "select",
      "default": "anthropic",
      "options": [
        {
          "value": "anthropic",
          "label": "Anthropic (Claude)"
        },
        {
          "value": "openai",
          "label": "OpenAI (GPT)"
        },
        {
          "value": "kimi",
          "label": "Moonshot (Kimi)"
        }
      ],
      "showIf": {
        "VIGIE_IA_MODE": [
          "cloud",
          "les-deux",
          "secours"
        ]
      }
    },
    {
      "key": "VIGIE_IA_MODELE",
      "label": "Modèle en nuage",
      "type": "string",
      "default": "",
      "pattern": "^[\\w.:/-]{0,120}$",
      "help": "Le nom exact du modèle chez le fournisseur.",
      "showIf": {
        "VIGIE_IA_MODE": [
          "cloud",
          "les-deux",
          "secours"
        ]
      }
    },
    {
      "key": "VIGIE_IA_CLE",
      "label": "Clé d'API du fournisseur",
      "type": "secret",
      "help": "Scellée par VIGIE, jamais relue. Les constats de l'audit partent chez ce fournisseur pour relecture.",
      "showIf": {
        "VIGIE_IA_MODE": [
          "cloud",
          "les-deux",
          "secours"
        ]
      }
    },
    {
      "key": "VIGIE_IA_APPELS_JOUR",
      "label": "Plafond d'appels en nuage par jour",
      "type": "integer",
      "default": 20,
      "min": 0,
      "max": 1000,
      "help": "Compteur local : au-delà, VIGIE n'appelle plus le nuage jusqu'au lendemain (la locale continue).",
      "showIf": {
        "VIGIE_IA_MODE": [
          "cloud",
          "les-deux",
          "secours"
        ]
      }
    },
    {
      "key": "SYSLOG_PORT",
      "label": "Port des journaux de la passerelle",
      "type": "integer",
      "default": 5514,
      "min": 1,
      "max": 65535,
      "required": true,
      "help": "Port UDP et TCP ouvert sur la machine pour les journaux de la passerelle UniFi (UniFi Network → Integrations → Activity Logging → SIEM Server, et CyberSecure → Traffic Logging). Seuls les émetteurs déclarés dans VIGIE → Bouclier sont lus ; sans liste, toute adresse privée."
    },
    {
      "key": "HUB_TOKEN",
      "label": "Jeton du Hub",
      "type": "secret",
      "generate": "random:32",
      "help": "Créé par le Hub. Il lui ouvre la lecture, les audits et les actions de VIGIE — jamais les réglages ni les secrets. Il signe aussi les jetons dérivés des services voisins (page Vigie de MapMyLAN)."
    },
    {
      "key": "HUB_ADMIN_TOKEN",
      "label": "Jeton d'administration des comptes",
      "type": "secret",
      "generate": "random:48",
      "advanced": true,
      "help": "Généré par le Hub, distinct du jeton du Hub : il ne sert qu'à gérer les comptes de VIGIE depuis Comptes des services."
    },
    {
      "key": "SOCLE_HTTP",
      "label": "Accès sans HTTPS",
      "type": "select",
      "default": "0",
      "required": true,
      "options": [
        {
          "value": "0",
          "label": "Non — l'interface de VIGIE est servie en HTTPS (par Relay)"
        },
        {
          "value": "1",
          "label": "Oui — réseau de confiance, mode dégradé"
        }
      ],
      "help": "Les clés d'accès n'existent qu'en HTTPS. En mode dégradé, l'administrateur se connecte avec mot de passe et application d'authentification, et VIGIE l'affiche partout.",
      "advanced": true
    },
    {
      "key": "SOCLE_CLE",
      "label": "Clé maîtresse",
      "type": "secret",
      "generate": "random:32",
      "help": "Scelle la clé d'IA en nuage, les jetons docker-control et Telegram, la clé de billetterie et les secrets TOTP. Créée par le Hub, gardée dans son coffre, jamais sur le volume de VIGIE."
    },
    {
      "key": "SOCLE_CLE_ANCIENNE",
      "label": "Clé maîtresse remplacée",
      "type": "secret",
      "advanced": true,
      "help": "Pendant une rotation seulement : la clé actuelle ici, une neuve dans « Clé maîtresse », redéployer, puis vider ce champ."
    },
    {
      "key": "SOCLE_JETON_INSTALLATION",
      "label": "Jeton d'installation",
      "type": "secret",
      "advanced": true,
      "help": "Vide : VIGIE en tire un au premier démarrage et l'écrit dans ses journaux. Il ne sert qu'à créer le premier compte."
    },
    {
      "key": "SOCLE_PROXYS",
      "label": "Relais de confiance",
      "type": "string",
      "default": "172.16.0.0/12",
      "advanced": true,
      "help": "Plages (CIDR, séparées par des virgules) des relais autorisés à transmettre l'adresse du client et le HTTPS : au moins celle du réseau du Hub, où vit Relay. Vide : VIGIE se croit en HTTP derrière Relay et refuse les clés d'accès."
    },
    {
      "key": "SOCLE_ORIGINES",
      "label": "Origines supplémentaires",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Adresses complètes acceptées en plus de celle de la page, quand un relais réécrit l'hôte."
    },
    {
      "key": "SOCLE_URL_PUBLIQUE",
      "label": "Adresse publique (courriels)",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Ex. https://vigie.exemple. Les liens des courriels et des tickets en partent."
    },
    {
      "key": "SOCLE_SMTP_HOTE",
      "label": "Relais SMTP",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Vide : les alertes de sécurité des comptes restent visibles dans VIGIE, sans courriel."
    },
    {
      "key": "SOCLE_SMTP_PORT",
      "label": "Port SMTP",
      "type": "number",
      "min": 1,
      "advanced": true,
      "help": "Vide : 465 en TLS, 587 en STARTTLS."
    },
    {
      "key": "SOCLE_SMTP_SECURITE",
      "label": "Chiffrement SMTP",
      "type": "select",
      "default": "tls",
      "advanced": true,
      "options": [
        {
          "value": "tls",
          "label": "TLS dès la connexion (465)"
        },
        {
          "value": "starttls",
          "label": "STARTTLS exigé (587)"
        }
      ]
    },
    {
      "key": "SOCLE_SMTP_UTILISATEUR",
      "label": "Identifiant SMTP",
      "type": "string",
      "default": "",
      "advanced": true
    },
    {
      "key": "SOCLE_SMTP_MOTDEPASSE",
      "label": "Mot de passe SMTP",
      "type": "secret",
      "advanced": true
    },
    {
      "key": "SOCLE_SMTP_DE",
      "label": "Adresse d'expédition",
      "type": "string",
      "default": "",
      "advanced": true
    }
  ],
  "api": {
    "baseUrl": "{{service.url}}",
    "auth": {
      "type": "bearer",
      "token": "{{service.token}}",
      "localToken": "HUB_TOKEN",
      "remoteToken": "HUB_TOKEN"
    }
  },
  "capabilities": {
    "provides": [
      "security.audit"
    ],
    "requires": [
      "network.inventory"
    ],
    "accepts": [
      "fleet.inventory",
      "containers.metrics",
      "llm.chat",
      "memory.learn"
    ]
  },
  "triggers": [
    {
      "id": "audit.done",
      "name": "Audit terminé",
      "description": "Un audit vient de finir : score, distribution des gravités.",
      "icon": "shield",
      "group": "Audit",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/audits",
          "query": {
            "limite": "10",
            "statut": "termine"
          }
        },
        "interval": "1m",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "debut": {
            "type": "integer"
          },
          "score": {
            "type": "integer"
          },
          "declencheur": {
            "type": "string"
          },
          "distribution": {
            "type": "object"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "debut": 1791014400000,
        "score": 73,
        "declencheur": "quotidien",
        "distribution": {
          "safe": 142,
          "info": 18,
          "faible": 11,
          "eleve": 6,
          "critique": 2
        }
      }
    },
    {
      "id": "intrusion.detected",
      "name": "Intrusion détectée",
      "description": "Un appareil montre un signe d'intrusion caractérisé (suspect, hors liste blanche, danger au-delà du seuil).",
      "icon": "alert",
      "group": "Veille",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "intrusion",
            "limite": "20"
          }
        },
        "interval": "30s",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "critique",
        "type": "intrusion",
        "titre": "Signe d’intrusion : android-3f2a (danger 92/100)",
        "texte": "Balayage de ports vers le réseau",
        "sujet": "android-3f2a"
      }
    },
    {
      "id": "isolation.auto",
      "name": "Appareil isolé automatiquement",
      "description": "La réaction rapide a mis un appareil en quarantaine (ou n'a pas pu).",
      "icon": "shield",
      "group": "Veille",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "reaction",
            "limite": "20"
          }
        },
        "interval": "30s",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "critique",
        "type": "reaction",
        "titre": "android-3f2a isolé automatiquement",
        "texte": "Signe d’intrusion. Fait. Annulable depuis VIGIE (Actions).",
        "sujet": "android-3f2a"
      }
    },
    {
      "id": "alert.new",
      "name": "Alerte de sécurité",
      "description": "Tout événement de veille de gravité élevée ou critique : nouveau port sensible, trafic suspect, VLAN plus isolé, constat grave…",
      "icon": "bell",
      "group": "Veille",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "min": "eleve",
            "limite": "50"
          }
        },
        "interval": "1m",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "eleve",
        "type": "port.nouveau",
        "titre": "Port ouvert sur nas : 23",
        "texte": "192.0.2.10 — service apparu depuis la passe précédente.",
        "sujet": "nas"
      }
    },
    {
      "id": "threat.blocked",
      "name": "Adresse bloquée",
      "description": "Le bouclier vient de bloquer une adresse extérieure (seul au-delà du seuil, ou à la main).",
      "icon": "shield",
      "group": "Bouclier",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "bouclier.bloque",
            "limite": "50"
          }
        },
        "interval": "1m",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "faible",
        "type": "bouclier.bloque",
        "titre": "Bloquée : 203.0.113.7 pour 1 h",
        "texte": "IPS : ET SCAN Potential SSH Scan (sid 2001219) ; listée par Spamhaus DROP",
        "sujet": "203.0.113.7"
      }
    },
    {
      "id": "host.compromised",
      "name": "Machine du réseau suspecte",
      "description": "Une machine du réseau se comporte comme une machine compromise : pot de miel touché, contact d'un serveur de commande, balayage interne.",
      "icon": "alert",
      "group": "Bouclier",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "bouclier.interne",
            "limite": "50"
          }
        },
        "interval": "30s",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "critique",
        "type": "bouclier.interne",
        "titre": "Machine du réseau suspecte : 192.0.2.77 (score 100)",
        "texte": "IPS, vers 192.0.2.2 (réseau interne) : Honeypot accessed",
        "sujet": "192.0.2.77"
      }
    },
    {
      "id": "storm.detected",
      "name": "Tempête (déni de service)",
      "description": "Des dizaines d'adresses frappent le même port en une minute : les plus bruyantes sont bloquées, Cloudflare peut passer en mode Under Attack ; au-delà, c'est l'amont.",
      "icon": "alert",
      "group": "Bouclier",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "bouclier.tempete",
            "limite": "20"
          }
        },
        "interval": "30s",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "critique",
        "type": "bouclier.tempete",
        "titre": "Tempête sur le port 443 : 120 adresses, 4 800 paquets en une minute",
        "texte": "20 adresses les plus bruyantes bloquées à la frontière · Cloudflare en mode Under Attack. Au-delà de la frontière, un déni de service volumétrique se traite en amont.",
        "sujet": "port 443"
      }
    },
    {
      "id": "host.alert",
      "name": "Alerte d'hôte (sentinelle)",
      "description": "Les journaux d'un hôte montrent une force brute, un compte forcé, un compte créé, une élévation suspecte, une écoute du réseau… (niveau 10 et plus).",
      "icon": "alert",
      "group": "Sentinelle",
      "delivery": {
        "type": "poll",
        "request": {
          "method": "GET",
          "path": "/api/evenements",
          "query": {
            "type": "sentinelle",
            "limite": "50"
          }
        },
        "interval": "30s",
        "items": "$",
        "dedupeKey": "$.id"
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quand": {
            "type": "integer"
          },
          "gravite": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titre": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "sujet": {
            "type": "string"
          }
        }
      },
      "sample": {
        "id": "Ab3dEf6hIj9k",
        "quand": 1791014400000,
        "gravite": "eleve",
        "type": "sentinelle",
        "titre": "srv-web : force brute SSH : huit échecs de la même adresse en deux minutes",
        "texte": "Niveau 10 (règle ssh.force-brute, sshd) — depuis 192.0.2.77 · compte root. Extrait : Failed password for root from 192.0.2.77 port 51234 ssh2",
        "sujet": "srv-web"
      }
    }
  ],
  "actions": [
    {
      "id": "state",
      "name": "État de la sécurité",
