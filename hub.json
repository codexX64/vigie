  "ai": {
    "exposeActions": true,
    "hints": "VIGIE audite la sécurité du réseau (règles Codex64, score sur 100 par domaine) et veille en continu. « État de la sécurité » pour le score et les priorités. Isoler un appareil coupe son accès au réseau : toujours demander validation. VIGIE refuse d’isoler la passerelle et les équipements d’infrastructure par le Hub, et n’agit que dans les plages déclarées dans MapMyLAN. Le bouclier (« État du bouclier ») lit les alertes de l'IPS de la passerelle UniFi et bloque seul les attaquants extérieurs ; « Bloquer une adresse » n'accepte qu'une adresse publique, hors liste blanche. La sentinelle lit les journaux des hôtes (SSH, sudo, comptes, NAS, hyperviseur, web, conteneurs) reçus en syslog et leur donne un niveau de 0 à 15 : force brute, compte forcé, compte créé ou ajouté aux administrateurs, écoute du réseau, outil de balayage web."
  },
  "accounts": {
    "tokenKey": "HUB_ADMIN_TOKEN",
    "roles": [
      "admin",
      "membre",
      "lecture"
    ],
    "adminRole": "admin",
    "invitation": true,
    "fields": {
      "id": "$.id",
      "name": "$.identifiant",
      "role": "$.role",
      "mfa": "$.a2f",
      "created": "$.cree",
      "lastSeen": "$.derniere"
    },
    "list": {
      "method": "GET",
      "path": "/api/compte/hub/comptes"
    },
    "create": {
      "method": "POST",
      "path": "/api/compte/hub/comptes",
      "body": {
        "identifiant": "{{params.username}}",
        "role": "{{params.role}}"
      }
    },
    "update": {
      "method": "PATCH",
      "path": "/api/compte/hub/comptes/{{params.id}}",
      "body": {
        "role": "{{params.role}}"
      }
    },
    "reset": {
      "method": "POST",
      "path": "/api/compte/hub/comptes/{{params.id}}/reinit",
      "body": {}
    },
    "remove": {
      "method": "DELETE",
      "path": "/api/compte/hub/comptes/{{params.id}}"
    }
  }
}
